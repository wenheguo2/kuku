# ============================================================
# 酷酷儿童故事 后端环境变量模板
# 用法：复制为 .env 并按本地实际填写。.env 不入库（见 .gitignore）。
# 凭据待办（AppID/支付/域名）见 开发文档/待办-外部凭据清单.md
# ============================================================

# ---- 服务 ----
NODE_ENV=development
# release/production 会强制关闭 mock/stub 并校验全部真实凭据
RELEASE_MODE=false
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=
# 静态资源根目录（相对 server/ 的 production 目录，替代 CDN）
STATIC_ROOT=../production

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kuku_stories
DB_USER=kuku_app
DB_PASSWORD=kuku2026

# ---- Redis (Memurai) ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- JWT ----
# 生产请替换为随机强密钥
JWT_SECRET=dev_only_change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---- 管理后台 ----
# 本地开发默认 admin/admin123；也可在 .env 覆盖。release/production 禁止明文口令，
# 必须设置 ADMIN_PASSWORD_SCRYPT=scrypt$<saltHex>$<hashHex>（生成命令见 开发文档/admin/README.md）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_PASSWORD_SCRYPT=
ADMIN_JWT_EXPIRES_IN=8h
# 管理端独立签名密钥：开发可留空(回退 JWT_SECRET)；release/production 必须配置 ≥32 位且与 JWT_SECRET 不同的随机值
ADMIN_JWT_SECRET=

# ---- 微信登录 ----
# App-only 部署设 false；小程序部署设 true。两端开关互不依赖。
WEAPP_AUTH_ENABLED=true
# mock = 本地免 AppID 联调（固定测试用户）；real = 调 code2session（需下方 AppID/Secret）
WX_LOGIN_MODE=mock
ALLOW_MOCK_LOGIN=true
WX_APPID=
WX_SECRET=

# ---- Android/iOS App 登录（与微信小程序登录完全独立） ----
# 只部署小程序时保持 false；部署 App 后端能力时设 true，并配置至少 32 位随机 pepper。
APP_AUTH_ENABLED=false
APP_AUTH_PEPPER=

# ---- 微信支付（真实通道尚未实现；开发联调留空并显式允许 stub）----
# 正式上线前保持 false；仅本地 stub 联调可设 true。App 内购不得使用此通道。
WECHAT_PAY_ENABLED=true
ALLOW_PAYMENT_STUB=true
WXPAY_MCH_ID=
WXPAY_API_V3_KEY=

# ---- 协议版本（必须与 miniapp/src/config/agreements.ts 一致）----
# release/production 不允许 draft；法务定稿时替换三项
USER_AGREEMENT_VERSION=2026-07-draft
PRIVACY_VERSION=2026-07-draft
CHILDREN_PRIVACY_VERSION=2026-07-draft
