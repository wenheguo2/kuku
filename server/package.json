  "description": "酷酷儿童故事 — NestJS 后端 (API + 静态资源服务，本地替代 CDN)",
  "author": "AI Developer",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
