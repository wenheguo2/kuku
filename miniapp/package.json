{
  "name": "kuku-stories-miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "酷酷儿童故事 — Taro 3 + React + TS 小程序（一套代码编译 微信小程序/APP/H5）",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "build:weapp": "taro build --type weapp",
    "build:weapp:release": "node scripts/build-weapp-release.cjs",
    "dev:h5": "taro build --type h5 --watch",
    "build:h5": "taro build --type h5",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.0",
    "@tarojs/components": "3.6.34",
    "@tarojs/helper": "3.6.34",
    "@tarojs/plugin-framework-react": "3.6.34",
    "@tarojs/plugin-platform-h5": "3.6.34",
    "@tarojs/plugin-platform-weapp": "3.6.34",
    "@tarojs/react": "3.6.34",
    "@tarojs/runtime": "3.6.34",
    "@tarojs/shared": "3.6.34",
    "@tarojs/taro": "3.6.34",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tarojs/cli": "3.6.34",
    "@tarojs/webpack5-runner": "3.6.34",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.5",
    "@types/webpack-env": "^1.18.5",
    "babel-preset-taro": "3.6.34",
    "miniprogram-automator": "^0.12.1",
    "sass": "^1.79.0",
    "typescript": "^5.6.2"
  }
}
