# 开发联调
NODE_ENV=development
TARO_APP_RELEASE=false
TARO_APP_USE_MOCK=true
TARO_APP_API_BASE_URL=http://localhost:3000/api/v1
TARO_APP_STATIC_BASE_URL=http://localhost:3000/static
TARO_APP_APPID=touristappid

# 正式提审时必须全部替换；协议经法务定稿后才能将最后一项设为 true
# 使用 npm run build:weapp:release；不要把普通联调包提交审核
# TARO_APP_RELEASE=true
# TARO_APP_USE_MOCK=false
# TARO_APP_API_BASE_URL=https://真实API域名/api/v1
# TARO_APP_STATIC_BASE_URL=https://真实CDN域名
# TARO_APP_APPID=真实小程序AppID
# TARO_APP_AGREEMENTS_FINAL=true
