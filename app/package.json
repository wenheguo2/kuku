{
  "name": "kuku-stories-app",
  "version": "0.1.0",
  "private": true,
  "description": "酷酷儿童故事 Android/iOS 独立 App",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "type-check": "tsc --noEmit",
    "doctor": "expo-doctor",
    "export": "expo export --platform android --output-dir dist/android && expo export --platform ios --output-dir dist/ios"
  },
  "dependencies": {
    "expo": "~57.0.4",
    "expo-asset": "~57.0.8",
    "expo-audio": "~57.0.2",
    "expo-crypto": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "expo-doctor": "^1.18.0",
    "typescript": "~6.0.3"
  }
}
